# Include the private config. No-op if it doesn't exists.
Include ~/.ssh/config.private

# Use the agent link ~/.ssh/rc refreshes on every login, so ssh and git keep
# working after a reconnect (Cursor, VS Code, ssh -A) even in processes that
# still hold a stale SSH_AUTH_SOCK. Applies only while the link is live.
Match exec "test -S %d/.ssh/agent.sock"
  IdentityAgent ~/.ssh/agent.sock

Host *
  UserKnownHostsFile ~/.ssh_known_hosts
  ServerAliveInterval 60
  ServerAliveCountMax 5

# Bypass firewall BS with ssh timeouts
Host github.com
  Hostname ssh.github.com
  Port 443