#!/bin/sh
# Run by sshd on every login to this box (sshd(8) "SSHRC").
# Keep ~/.ssh/agent.sock pointing at the newest forwarded agent, so processes
# that outlive a reconnect (Claude sessions, tmux) still reach it through the
# IdentityAgent rule in ~/.ssh/config.private.
if [ -S "$SSH_AUTH_SOCK" ]; then
    ln -sfn "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
fi

# A user rc replaces sshd's own X11 cookie setup; this is the sshd(8) default.
if read proto cookie && [ -n "$DISPLAY" ]; then
    if [ "$(echo "$DISPLAY" | cut -c1-10)" = 'localhost:' ]; then
        echo add unix:"$(echo "$DISPLAY" | cut -c11-)" "$proto" "$cookie"
    else
        echo add "$DISPLAY" "$proto" "$cookie"
    fi | xauth -q -
fi
