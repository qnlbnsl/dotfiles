#!/usr/bin/env bash
# libvirt qemu hook (called as: <domain> <operation> <sub-operation>).
# win11 takes the RTX A1000 from the host only while it runs: libvirt detaches it from
# nvidia (managed="yes" in arch/vm/win11.xml) on start and gives it back on shutdown.
# The nvidia driver can't release a GPU something still has open, so refuse to start
# the VM while any process uses the A1000, and say which.
[[ $1 == win11 && $2 == prepare && $3 == begin ]] || exit 0

GPU=0000:0d:00.0
[[ $(basename "$(readlink -f /sys/bus/pci/devices/$GPU/driver)") == nvidia ]] || exit 0

minor=$(awk -F: '/Device Minor/ {gsub(/[ \t]/, "", $2); print $2}' /proc/driver/nvidia/gpus/$GPU/information)
pids=$(fuser "/dev/nvidia$minor" /dev/dri/by-path/pci-$GPU-card /dev/dri/by-path/pci-$GPU-render 2>/dev/null)
users=""
for pid in $(tr -cs '0-9' ' ' <<<"$pids"); do
  users+="$(cat /proc/$pid/comm 2>/dev/null)($pid) "
done
if [[ -n $users ]]; then
  echo "RTX A1000 is in use on the host by: $users- stop those before starting win11." >&2
  exit 1
fi
exit 0
