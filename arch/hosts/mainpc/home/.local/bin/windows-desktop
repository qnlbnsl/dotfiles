#!/usr/bin/env bash
# Windows 11 VM desktop through Looking Glass, one window per Windows screen: screen 1 on
# workspace 1 (left monitor), screen 2 on 11 (right monitor), screen 3 on 21. Screen N comes
# from shared-memory device /dev/kvmfr<N-1> (one per screen, see modprobe.d/kvmfr.conf);
# ~/.config/hypr/windows-vm.lua places the windows.
#   windows-desktop           start the VM if needed and go to this monitor's Windows workspace
#   windows-desktop --show    open the Looking Glass windows if the VM runs (called by Hyprland)
#   windows-desktop --status  JSON for the bar icon (text, tooltip, class)
#   windows-desktop --watch   follow the VM (started from Hyprland): when it starts, each
#                             monitor's first workspace makes room for Windows (1 -> 2 -> 3 ...
#                             up to the first empty one); when it stops, close Looking Glass
#                             and move everything back.
#   windows-desktop --shift / --unshift   do just that part.
#   windows-desktop --swap    swap which monitor shows Windows screens 1 and 2 (bar icon right
#                             click); remembered across reboots.
set -u

VM=win11
# Windows screens to show: one per dummy plug in the A1000's outputs. The Virtual Display Driver
# screens stalled the whole Windows desktop (WUDFHost pegging a core, frames stopping for
# 250-500 ms), so it's disabled in Windows; raise this with more real outputs.
MAX_SCREENS=2
virsh_(){ virsh -c qemu:///system "$@"; }
running() { [[ $(virsh_ domstate "$VM" 2>/dev/null | head -1) == running ]]; }

lg_class() { (( $1 == 1 )) && echo looking-glass-client || echo "looking-glass-client-$1"; }
lg_open() { hyprctl clients -j | jq -e --arg c "$1" 'any(.[]; .class == $c)' >/dev/null; }

# This flag file means screens 1 and 2 trade workspaces; windows-vm.lua reads it too.
SWAP_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/windows-desktop/swapped
screen_ws() { # <screen>: the workspace that shows it
  local k=$1
  [[ -f $SWAP_FILE ]] && (( k <= 2 )) && k=$(( 3 - k ))
  echo $(( (k - 1) * 10 + 1 ))
}
lg_info() { # <class>: "<address> <workspace> <fullscreen>" if that window is open
  hyprctl clients -j | jq -r --arg c "$1" 'first(.[] | select(.class == $c)) | "\(.address) \(.workspace.id) \(.fullscreen)"'
}
place() { # put each open Looking Glass window on its workspace, fullscreen
  local k a ws fs want
  for (( k = 1; k <= MAX_SCREENS; k++ )); do
    read -r a ws fs <<<"$(lg_info "$(lg_class "$k")")"
    want=$(screen_ws "$k")
    [[ -n ${a:-} && $ws != "$want" ]] || continue
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$want\", window = \"address:$a\", follow = false })" >/dev/null
  done
  # After every move: two fullscreen windows sharing a workspace, even briefly, can drop it.
  for (( k = 1; k <= MAX_SCREENS; k++ )); do
    read -r a ws fs <<<"$(lg_info "$(lg_class "$k")")"
    [[ -n ${a:-} && ${fs:-1} == 0 ]] || continue
    hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"fullscreen\", window = \"address:$a\" })" >/dev/null
  done
}
swap() {
  mkdir -p "$(dirname "$SWAP_FILE")"
  if [[ -f $SWAP_FILE ]]; then rm -f "$SWAP_FILE"; else : >"$SWAP_FILE"; fi
  place
}

show() {
  running || return 0
  # Hyprland can call this several times while the windows open.
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/windows-desktop.lock"
  flock -n 9 || return 0
  local devs mons screens k class
  devs=$(ls /dev/kvmfr[0-9]* 2>/dev/null | wc -l)
  mons=$(hyprctl monitors -j | jq length)
  screens=$(( devs < mons ? devs : mons ))
  (( screens > MAX_SCREENS )) && screens=$MAX_SCREENS
  for (( k = 1; k <= screens; k++ )); do
    class=$(lg_class $k)
    lg_open "$class" && continue
    if (( k == 1 )); then
      setsid uwsm-app -- looking-glass-client >/dev/null 2>&1 9>&- &
      # QEMU's SPICE server gives the audio channels only to the first client that connects,
      # so screen 1 (the one with audio) must be connected before the others start. Its
      # window appears right after it connects.
      for _ in $(seq 25); do lg_open "$class" && break; sleep 0.2; done
    else
      # Extra screens: own shared memory and app id; audio only from screen 1. Clipboard stays
      # on: with several SPICE clients the guest agent answers whichever connected last.
      setsid uwsm-app -- looking-glass-client -f "/dev/kvmfr$((k - 1))" win:appId="$class" \
        win:title="Windows $k" spice:audio=no >/dev/null 2>&1 9>&- &
    fi
  done
  # Hold the lock until the windows exist (or 10s pass).
  for _ in $(seq 50); do
    lg_open "$(lg_class "$screens")" && break
    sleep 0.2
  done
  place
}

LG_CLASS=looking-glass-client
SHIFTED=${XDG_RUNTIME_DIR:-/tmp}/windows-desktop.shifted   # lines: <first ws> <last ws moved>

# First workspace of each monitor, left to right: 1, 11, 21, ...
bases() { hyprctl monitors -j | jq -r 'sort_by(.x) | to_entries[] | .key * 10 + 1' | head -n "$MAX_SCREENS"; }
# Addresses of the (non-Looking Glass) windows on a workspace.
windows_on() { hyprctl clients -j | jq -r --argjson ws "$1" --arg lg "$LG_CLASS" '.[] | select(.workspace.id == $ws and (.class | startswith($lg) | not) and (.pinned | not)) | .address'; }
move_all() { # <from ws> <to ws>
  local a
  for a in $(windows_on "$1"); do
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$2\", window = \"address:$a\", follow = false })" >/dev/null
  done
}

shift_ws() {
  [[ -s $SHIFTED ]] && return 0   # already made room
  : >"$SHIFTED"
  local b last n
  for b in $(bases); do
    [[ -n $(windows_on "$b") ]] || continue
    # Push b .. last up by one, where last+1 is the first empty workspace (or b+9).
    last=$b
    while (( last < b + 9 )) && [[ -n $(windows_on $((last + 1))) ]]; do last=$((last + 1)); done
    for (( n = last; n >= b; n-- )); do move_all "$n" $((n + 1)); done
    echo "$b $last" >>"$SHIFTED"
  done
}

unshift_ws() {
  [[ -f $SHIFTED ]] || return 0
  local b last n
  while read -r b last; do
    [[ -n $b ]] || continue
    # Only if nothing new landed on the Windows workspace meanwhile.
    [[ -z $(windows_on "$b") ]] || continue
    for (( n = b + 1; n <= last + 1; n++ )); do move_all "$n" $((n - 1)); done
  done <"$SHIFTED"
  rm -f "$SHIFTED"
}

sync_state() { # catch up after missing events (login, libvirt restart)
  if running; then shift_ws; elif [[ -s $SHIFTED ]]; then pkill -x looking-glass-c; unshift_ws; fi
}

watch_vm() {
  # One watcher per session.
  exec 8>"${XDG_RUNTIME_DIR:-/tmp}/windows-desktop.watch.lock"
  flock -n 8 || exit 0
  # virsh exits when libvirtd restarts (e.g. make arch-vm): reconnect and catch up.
  while :; do
    sync_state
    virsh_ event --domain "$VM" --event lifecycle --loop 2>/dev/null | while read -r line; do
      case $line in
        *": Started"*) shift_ws ;;
        *": Stopped"*)
          pkill -x looking-glass-c   # comm is cut to 15 characters
          unshift_ws ;;
      esac
    done
    sleep 3
  done
}

case ${1:-} in
  --status)
    glyph=$''
    if running; then
      printf '{"text":"%s","tooltip":"Windows 11: running (workspace 1 / 11). Right click swaps the screens.","class":"active"}\n' "$glyph"
    else
      printf '{"text":"%s","tooltip":"Windows 11: off (click to start)","class":"inactive"}\n' "$glyph"
    fi
    exit 0 ;;
  --show) show; exit 0 ;;
  --swap) swap; exit 0 ;;
  --shift) shift_ws; exit 0 ;;
  --unshift) unshift_ws; exit 0 ;;
  --watch) watch_vm; exit 0 ;;
esac

if ! running; then
  notify-send "Windows 11" "Starting the VM…"
  if ! err=$(virsh_ start "$VM" 2>&1); then
    # e.g. the guard hook naming what still holds the RTX A1000
    notify-send -u critical "Windows 11 didn't start" "$err"
    exit 1
  fi
fi

# This monitor's first workspace: monitors left to right own 1-10, 11-20, ...
focused=$(hyprctl monitors -j | jq -r 'sort_by(.x) | to_entries[] | select(.value.focused) | .key')
ws=$(( ${focused:-0} * 10 + 1 ))
hyprctl dispatch "hl.dsp.focus({ workspace = \"$ws\" })" >/dev/null
show
