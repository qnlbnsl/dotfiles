diff --git c/modules/overview/GlassSlot.qml i/modules/overview/GlassSlot.qml
new file mode 100644
index 0000000..aa1b6b8
--- /dev/null
+++ i/modules/overview/GlassSlot.qml
@@ -0,0 +1,38 @@
+import QtQuick
+import "../../common"
+
+// macOS "liquid glass": a frosted, neutral pane (Liquid Glass has no color of its own) with a soft
+// top highlight and a hairline edge. Marks where a dragged window will land.
+Rectangle {
+    id: root
+    radius: 6
+    color: "transparent"
+    border.width: 1
+    border.color: "#8CFFFFFF"
+    gradient: Gradient {
+        GradientStop { position: 0.0; color: "#5CFFFFFF" }
+        GradientStop { position: 0.45; color: "#29FFFFFF" }
+        GradientStop { position: 1.0; color: "#14FFFFFF" }
+    }
+
+    // Inner hairline: the second edge that gives glass its depth.
+    Rectangle {
+        anchors.fill: parent
+        anchors.margins: 1
+        radius: Math.max(0, root.radius - 1)
+        color: "transparent"
+        border.width: 1
+        border.color: "#1FFFFFFF"
+    }
+
+    Text {
+        anchors.centerIn: parent
+        text: "+"
+        color: "#EBFFFFFF"
+        style: Text.Raised
+        styleColor: "#33000000"
+        font.pixelSize: Math.max(8, Math.round(Math.min(root.width, root.height) * 0.45))
+        font.weight: Font.Light
+        font.family: Appearance.font.family.main
+    }
+}
diff --git c/modules/overview/LiveDrag.qml i/modules/overview/LiveDrag.qml
new file mode 100644
index 0000000..026a838
--- /dev/null
+++ i/modules/overview/LiveDrag.qml
@@ -0,0 +1,837 @@
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import Quickshell.Wayland
+import Quickshell.Widgets
+import Quickshell.Hyprland
+import "../../common"
+import "../../services"
+import "."
+
+// Live rearranging on the normal desktop (Mission Control step 4).
+//
+// Super+drag on a window (hypr/bindings.lua) calls `livedrag start` on the press and
+// `livedrag drop` on the release. The real windows stay put while the button is held: an
+// overlay on every monitor shows the layout the drop would make (the other windows already in
+// their new places, a glass slot where the dragged one lands) and a small copy of the dragged
+// window follows the cursor. On the drop the dragged window is moved in one hyprctl batch.
+//
+// The overlay holds a focus grab over all monitors: without it Hyprland keeps the pointer on
+// the surface under the press (the bind ate the press, so that's no surface at all) and the
+// overlay would get no motion while the button is down.
+//
+// Where a window lands, on the window under the cursor (as it is with the dragged one taken
+// out): near an edge, that window is split in half and the dragged one takes that side; in the
+// middle (same desktop only) the two swap; on an empty desktop it fills it. Floating windows
+// are just moved. The split tree is worked out from window geometry, the same way as
+// ws-layout does it (dwindle doesn't expose its tree).
+Scope {
+    id: ld
+
+    // { address, floating, ws, rect: {x,y,w,h}, grabU, grabV, toplevel } while dragging.
+    property var drag: null
+    property point pos: Qt.point(0, 0)     // cursor, global layout coordinates
+    property point startPos: Qt.point(0, 0)
+    property bool moved: false
+    property var plan: null                 // what the drop would do, see computePlan()
+    property bool dropping: false           // drop sent; hold the picture until windows settle
+
+    property var snapshot: []               // clients when the drag started
+    property var monitorsSnap: []
+    property var layoutCache: ({})          // ws -> { tree, box } of the desktop as it was
+
+    // Hyprland options, read once.
+    property real gapsIn: 4
+    property var gapsOut: [8, 8, 8, 8]      // top right bottom left
+    property real border: 1
+    property real rounding: 0
+    property var dwindleSaved: ({})
+    property bool noWarps: false
+
+    readonly property bool active: drag !== null
+    property bool dryRun: false             // debugging: show the drag, don't move anything
+    property bool trace: false              // debugging: log moves, applied states and the drop
+    property int traceCount: 0
+
+    Component.onCompleted: readOptions.running = true
+
+    Process {
+        id: readOptions
+        command: ["sh", "-c", "for o in general:gaps_in general:gaps_out general:border_size decoration:rounding "
+            + "dwindle:force_split dwindle:split_width_multiplier dwindle:default_split_ratio dwindle:smart_split "
+            + "dwindle:use_active_for_splits cursor:no_warps; do hyprctl getoption $o -j | tr -d '\\n'; echo; done"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const v = {};
+                for (const line of text.split("\n")) {
+                    if (!line.trim())
+                        continue;
+                    try {
+                        const o = JSON.parse(line);
+                        v[o.option] = o.css ?? o.int ?? o.float ?? o.bool;
+                    } catch (e) {}
+                }
+                const css = s => `${s ?? ""}`.trim().split(/\s+/).map(Number);
+                ld.gapsIn = css(v["general:gaps_in"])[0] ?? 4;
+                const go = css(v["general:gaps_out"]);
+                ld.gapsOut = go.length === 4 ? go : [go[0] ?? 8, go[0] ?? 8, go[0] ?? 8, go[0] ?? 8];
+                ld.border = v["general:border_size"] ?? 1;
+                ld.rounding = v["decoration:rounding"] ?? 0;
+                ld.noWarps = !!(v["cursor:no_warps"] ?? false);
+                ld.dwindleSaved = {
+                    force_split: v["dwindle:force_split"] ?? 0,
+                    split_width_multiplier: v["dwindle:split_width_multiplier"] ?? 1,
+                    default_split_ratio: v["dwindle:default_split_ratio"] ?? 1,
+                    smart_split: !!(v["dwindle:smart_split"] ?? false),
+                    use_active_for_splits: !!(v["dwindle:use_active_for_splits"] ?? true)
+                };
+            }
+        }
+    }
+
+    // --- geometry ---------------------------------------------------------------------------
+
+    function monRect(m) {
+        const t = (m.transform ?? 0) % 2 === 1;
+        return { x: m.x, y: m.y, w: (t ? m.height : m.width) / m.scale, h: (t ? m.width : m.height) / m.scale };
+    }
+
+    function monitorAt(p) {
+        for (const m of monitorsSnap) {
+            const r = monRect(m);
+            if (p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h)
+                return m;
+        }
+        return null;
+    }
+
+    function monitorOfWs(ws) {
+        return monitorsSnap.find(m => m.activeWorkspace?.id === ws) ?? null;
+    }
+
+    // Dwindle's root box: the work area (monitor minus reserved space and gaps_out).
+    function workArea(m) {
+        const r = monRect(m), res = m.reserved ?? [0, 0, 0, 0];
+        const x = r.x + res[0] + gapsOut[3], y = r.y + res[1] + gapsOut[0];
+        return { x: x, y: y, w: r.w - res[0] - res[2] - gapsOut[1] - gapsOut[3],
+                 h: r.h - res[1] - res[3] - gapsOut[0] - gapsOut[2] };
+    }
+
+    function tiledOn(ws) {
+        return snapshot.filter(c => c.workspace?.id === ws && c.mapped && !c.hidden && !c.pinned && !c.floating);
+    }
+
+    function rectOf(c) {
+        return { x: c.at[0], y: c.at[1], w: c.size[0], h: c.size[1] };
+    }
+
+    // First line along an axis with every window wholly on one side (ws-layout's cut()).
+    function cut(items, axis) {
+        const key = axis === 0 ? "x" : "y", ext = axis === 0 ? "w" : "h";
+        const s = items.slice().sort((a, b) => a.r[key] - b.r[key]);
+        let reach = -Infinity;
+        for (let i = 0; i < s.length - 1; ++i) {
+            reach = Math.max(reach, s[i].r[key] + s[i].r[ext]);
+            if (reach <= s[i + 1].r[key] + 2)
+                return { first: s.slice(0, i + 1), second: s.slice(i + 1), line: (reach + s[i + 1].r[key]) / 2 };
+        }
+        return null;
+    }
+
+    function splitTree(items, box) {
+        if (items.length === 1)
+            return { window: items[0].a };
+        for (const axis of [0, 1]) {
+            const found = cut(items, axis);
+            if (!found)
+                continue;
+            let ba, bb, ratio;
+            if (axis === 0) {
+                ba = { x: box.x, y: box.y, w: found.line - box.x, h: box.h };
+                bb = { x: found.line, y: box.y, w: box.x + box.w - found.line, h: box.h };
+                ratio = 2 * ba.w / box.w;
+            } else {
+                ba = { x: box.x, y: box.y, w: box.w, h: found.line - box.y };
+                bb = { x: box.x, y: found.line, w: box.w, h: box.y + box.h - found.line };
+                ratio = 2 * ba.h / box.h;
+            }
+            return { split: axis === 0 ? "h" : "v", ratio: ratio,
+                     a: splitTree(found.first, ba), b: splitTree(found.second, bb) };
+        }
+        return null; // overlapping windows (a group): no layout
+    }
+
+    // The desktop as it was when the drag started: { tree, box }, tree null when empty or unknown.
+    function layoutOf(ws) {
+        if (layoutCache[ws] !== undefined)
+            return layoutCache[ws];
+        const wins = tiledOn(ws);
+        const m = monitorOfWs(ws) ?? monitorsSnap.find(mm => mm.id === snapshot.find(c => c.workspace?.id === ws)?.monitor);
+        let result = { tree: null, box: m ? workArea(m) : null, blocked: false };
+        if (wins.some(c => c.fullscreen))
+            result.blocked = true;
+        else if (wins.length > 0) {
+            const items = wins.map(c => ({ a: c.address, r: rectOf(c) }));
+            const b = border;
+            const xs = [], ys = [];
+            for (const i of items) {
+                xs.push(i.r.x, i.r.x + i.r.w);
+                ys.push(i.r.y, i.r.y + i.r.h);
+            }
+            const box = { x: Math.min(...xs) - b, y: Math.min(...ys) - b,
+                          w: Math.max(...xs) - Math.min(...xs) + 2 * b, h: Math.max(...ys) - Math.min(...ys) + 2 * b };
+            const tree = splitTree(items, box);
+            result = { tree: tree, box: box, blocked: tree === null };
+        }
+        const c = Object.assign({}, layoutCache);
+        c[ws] = result;
+        layoutCache = c;
+        return result;
+    }
+
+    function prune(node, address) {
+        if (!node)
+            return null;
+        if (node.window !== undefined)
+            return node.window === address ? null : node;
+        const a = prune(node.a, address), b = prune(node.b, address);
+        if (a && b)
+            return { split: node.split, ratio: node.ratio, a: a, b: b };
+        return a || b;
+    }
+
+    function insert(node, target, side, address) {
+        if (node.window !== undefined) {
+            if (node.window !== target)
+                return node;
+            const me = { window: address };
+            const first = side === "left" || side === "top";
+            return { split: side === "left" || side === "right" ? "h" : "v", ratio: 1,
+                     a: first ? me : node, b: first ? node : me };
+        }
+        return { split: node.split, ratio: node.ratio, a: insert(node.a, target, side, address),
+                 b: insert(node.b, target, side, address) };
+    }
+
+    function swapLeaves(node, x, y) {
+        if (node.window !== undefined)
+            return { window: node.window === x ? y : node.window === y ? x : node.window };
+        return { split: node.split, ratio: node.ratio, a: swapLeaves(node.a, x, y), b: swapLeaves(node.b, x, y) };
+    }
+
+    // Window rectangles of a tree laid out in box: a window sits inside its cell by the border
+    // on the work area's edges and by gaps_in + border between windows.
+    function rects(tree, box) {
+        const out = {};
+        const inner = gapsIn + border, outer = border, eps = 0.5;
+        const walk = (n, c) => {
+            if (n.window !== undefined) {
+                const l = Math.abs(c.x - box.x) < eps ? outer : inner;
+                const t = Math.abs(c.y - box.y) < eps ? outer : inner;
+                const r = Math.abs(c.x + c.w - box.x - box.w) < eps ? outer : inner;
+                const b = Math.abs(c.y + c.h - box.y - box.h) < eps ? outer : inner;
+                out[n.window] = { x: c.x + l, y: c.y + t, w: c.w - l - r, h: c.h - t - b };
+                return;
+            }
+            if (n.split === "h") {
+                const wa = c.w * n.ratio / 2;
+                walk(n.a, { x: c.x, y: c.y, w: wa, h: c.h });
+                walk(n.b, { x: c.x + wa, y: c.y, w: c.w - wa, h: c.h });
+            } else {
+                const ha = c.h * n.ratio / 2;
+                walk(n.a, { x: c.x, y: c.y, w: c.w, h: ha });
+                walk(n.b, { x: c.x, y: c.y + ha, w: c.w, h: c.h - ha });
+            }
+        };
+        if (tree && box)
+            walk(tree, box);
+        return out;
+    }
+
+    function inside(r, p) {
+        return p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;
+    }
+
+    function distance(r, p) {
+        const dx = Math.max(r.x - p.x, 0, p.x - r.x - r.w), dy = Math.max(r.y - p.y, 0, p.y - r.y - r.h);
+        return Math.hypot(dx, dy);
+    }
+
+    // What the drop would do with the cursor at p:
+    // { kind: "split"|"swap"|"empty"|"float"|"none", ws, target, side, slot (global rect),
+    //   predicted: { ws: { address: rect } }, noop }
+    function computePlan(p) {
+        const d = drag;
+        const m = monitorAt(p);
+        if (!d || !m || (m.specialWorkspace?.id ?? 0) !== 0)
+            return { kind: "none", predicted: {} };
+        const ws = m.activeWorkspace.id;
+        const predicted = {};
+
+        if (d.floating) {
+            const x = Math.round(p.x - d.grabU * d.rect.w), y = Math.round(p.y - d.grabV * d.rect.h);
+            const keep = w => {
+                const out = {};
+                for (const c of tiledOn(w))
+                    out[c.address] = rectOf(c);
+                return out;
+            };
+            predicted[d.ws] = keep(d.ws);
+            if (ws !== d.ws)
+                predicted[ws] = keep(ws);
+            return { kind: "float", ws: ws, x: x, y: y, slot: { x: x, y: y, w: d.rect.w, h: d.rect.h },
+                     predicted: predicted, noop: ws === d.ws && x === d.rect.x && y === d.rect.y };
+        }
+
+        const src = layoutOf(d.ws);
+        const srcBase = prune(src.tree, d.address);
+        let tgt = ws === d.ws ? { tree: srcBase, box: src.box, blocked: src.blocked } : layoutOf(ws);
+        if (tgt.blocked || src.blocked)
+            return { kind: "none", predicted: {} };
+        if (ws !== d.ws)
+            predicted[d.ws] = rects(srcBase, src.box);
+
+        if (!tgt.tree) {
+            const box = workArea(m);
+            predicted[ws] = rects({ window: d.address }, box);
+            return { kind: "empty", ws: ws, slot: predicted[ws][d.address], predicted: predicted, noop: false };
+        }
+
+        const base = rects(tgt.tree, tgt.box);
+        let target = null, best = Infinity;
+        for (const a in base) {
+            const dist = inside(base[a], p) ? -1 : distance(base[a], p);
+            if (dist < best) {
+                best = dist;
+                target = a;
+            }
+        }
+        const r = base[target];
+        const u = (p.x - r.x) / r.w, v = (p.y - r.y) / r.h;
+        let kind = "split", side, tree;
+        if (ws === d.ws && Math.abs(u - 0.5) < 0.18 && Math.abs(v - 0.5) < 0.18) {
+            kind = "swap";
+            tree = swapLeaves(src.tree, d.address, target);
+        } else {
+            const edges = [["left", u], ["right", 1 - u], ["top", v], ["bottom", 1 - v]];
+            side = edges.reduce((m, e) => e[1] < m[1] ? e : m)[0];
+            tree = insert(tgt.tree, target, side, d.address);
+        }
+        predicted[ws] = rects(tree, tgt.box);
+        const slot = predicted[ws][d.address];
+        let noop = false;
+        if (ws === d.ws) {
+            noop = true;
+            for (const c of tiledOn(ws)) {
+                const a = rectOf(c), b = predicted[ws][c.address];
+                if (!b || Math.abs(a.x - b.x) > 2 || Math.abs(a.y - b.y) > 2 || Math.abs(a.w - b.w) > 2 || Math.abs(a.h - b.h) > 2) {
+                    noop = false;
+                    break;
+                }
+            }
+        }
+        return { kind: kind, ws: ws, target: target, side: side, base: r, slot: slot, predicted: predicted, noop: noop };
+    }
+
+    // --- start, move, drop ------------------------------------------------------------------
+    //
+    // The real windows are the preview: while the button is held the dragged window is put
+    // where the drop would put it, so the other windows really resize and redraw (copies could
+    // only be scaled). Each change is one hyprctl batch, run one at a time; the latest wanted
+    // state wins. "orig" is the window back in its own place (for a swap, which is applied on
+    // the drop and shown with copies meanwhile, for no target, and for dropping it back).
+
+    property string appliedKey: "orig"
+    property string applyingKey: ""
+    property string wantKey: "orig"
+    property var wantPlan: null
+    property bool applyBusy: false
+    property var applySteps: []
+    property bool pendingFinish: false
+    property var restore: null              // how to put the window back in its own place
+    readonly property string origFile: `${Quickshell.env("XDG_RUNTIME_DIR")}/livedrag-orig.json`
+
+    function findParent(node, address) {
+        if (!node || node.window !== undefined)
+            return null;
+        if (node.a.window === address || node.b.window === address)
+            return node;
+        return findParent(node.a, address) ?? findParent(node.b, address);
+    }
+
+    function begin(cursor) {
+        if (trace)
+            console.log("livedrag begin", cursor);
+        snapshot = HyprlandData.windowList;
+        monitorsSnap = HyprlandData.monitors;
+        layoutCache = ({});
+        const m = monitorAt(cursor);
+        if (!m || (m.specialWorkspace?.id ?? 0) !== 0)
+            return;
+        const ws = m.activeWorkspace.id;
+        const hits = snapshot.filter(c => c.workspace?.id === ws && c.mapped && !c.hidden && !c.pinned && inside(rectOf(c), cursor));
+        const c = hits.find(c => c.floating) ?? hits[0];
+        if (!c || c.fullscreen)
+            return;
+        const r = rectOf(c);
+        pos = cursor;
+        startPos = cursor;
+        moved = false;
+        plan = null;
+        appliedKey = "orig";
+        wantKey = "orig";
+        wantPlan = null;
+        applySteps = [];
+        pendingFinish = false;
+        restore = null;
+        if (!c.floating) {
+            const src = layoutOf(ws);
+            const parent = findParent(src.tree, c.address);
+            if (src.blocked)
+                return;
+            if (!parent) {
+                restore = { kind: "alone" };
+            } else {
+                const first = parent.a.window === c.address;
+                const sib = first ? parent.b : parent.a;
+                if (sib.window !== undefined) {
+                    restore = { kind: "insert", sibling: sib.window, ratio: parent.ratio,
+                                side: parent.split === "h" ? (first ? "left" : "right") : (first ? "top" : "bottom") };
+                } else {
+                    // The sibling is a whole subtree, which one insertion can't recreate.
+                    restore = { kind: "layout" };
+                    recordOrig.command = ["sh", "-c", `ws-layout record ${ws} > '${origFile}'`];
+                    recordOrig.running = true;
+                }
+            }
+        }
+        drag = {
+            address: c.address, floating: c.floating, ws: ws, rect: r,
+            grabU: (cursor.x - r.x) / r.w, grabV: (cursor.y - r.y) / r.h,
+            toplevel: ToplevelManager.toplevels.values.find(t => `0x${t.HyprlandToplevel.address}` === c.address) ?? null
+        };
+    }
+
+    Process { id: recordOrig }
+
+    function moveTo(p) {
+        if (!drag || dropping)
+            return;
+        pos = p;
+        if (!moved && Math.hypot(p.x - startPos.x, p.y - startPos.y) < 8)
+            return;
+        moved = true;
+        plan = computePlan(p);
+        if (trace && (traceCount++ % 6) === 0)
+            console.log("livedrag move", p, plan?.kind, plan?.ws, plan?.target, plan?.side);
+        const key = keyOf(plan);
+        if (key === wantKey)
+            return;
+        wantKey = key;
+        wantPlan = plan;
+        // Floating windows follow the cursor (throttled); tiled ones wait until the cursor
+        // rests in a zone for a moment, so crossing zones doesn't reshuffle every window.
+        if (drag.floating) {
+            if (!applyTimer.running)
+                applyTimer.start();
+        } else {
+            applyTimer.restart();
+        }
+    }
+
+    function keyOf(p) {
+        if (!p || p.kind === "none" || p.kind === "swap" || p.noop)
+            return "orig";
+        if (p.kind === "split")
+            return `split|${p.ws}|${p.target}|${p.side}`;
+        if (p.kind === "empty")
+            return `empty|${p.ws}`;
+        return `float|${p.ws}|${p.x}|${p.y}`;
+    }
+
+    Timer {
+        id: applyTimer
+        interval: 70
+        onTriggered: ld.pump()
+    }
+
+    function pump() {
