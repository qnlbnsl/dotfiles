diff --git c/modules/overview/GlassSlot.qml i/modules/overview/GlassSlot.qml
new file mode 100644
index 0000000..aa1b6b8
--- /dev/null
+++ i/modules/overview/GlassSlot.qml
@@ -0,0 +1,38 @@
+import QtQuick
+import "../../common"
+
+// macOS "liquid glass": a frosted, neutral pane (Liquid Glass has no color of its own) with a soft
+// top highlight and a hairline edge. Marks where a dragged window will land.
+Rectangle {
+    id: root
+    radius: 6
+    color: "transparent"
+    border.width: 1
+    border.color: "#8CFFFFFF"
+    gradient: Gradient {
+        GradientStop { position: 0.0; color: "#5CFFFFFF" }
+        GradientStop { position: 0.45; color: "#29FFFFFF" }
+        GradientStop { position: 1.0; color: "#14FFFFFF" }
+    }
+
+    // Inner hairline: the second edge that gives glass its depth.
+    Rectangle {
+        anchors.fill: parent
+        anchors.margins: 1
+        radius: Math.max(0, root.radius - 1)
+        color: "transparent"
+        border.width: 1
+        border.color: "#1FFFFFFF"
+    }
+
+    Text {
+        anchors.centerIn: parent
+        text: "+"
+        color: "#EBFFFFFF"
+        style: Text.Raised
+        styleColor: "#33000000"
+        font.pixelSize: Math.max(8, Math.round(Math.min(root.width, root.height) * 0.45))
+        font.weight: Font.Light
+        font.family: Appearance.font.family.main
+    }
+}
diff --git c/modules/overview/MissionControlWindows.qml i/modules/overview/MissionControlWindows.qml
new file mode 100644
index 0000000..77feb33
--- /dev/null
+++ i/modules/overview/MissionControlWindows.qml
@@ -0,0 +1,239 @@
+import QtQuick
+import QtQuick.Effects
+import Quickshell
+import Quickshell.Wayland
+import Quickshell.Widgets
+import Quickshell.Hyprland
+import "../../common"
+import "../../services"
+
+// macOS Mission Control: the active desktop's windows below the desktop strip, laid out as on
+// the desktop. Drag a window onto a desktop thumbnail (on either monitor) to move it there;
+// click to focus, middle-click to close.
+Item {
+    id: root
+    required property var panelWindow
+    property var widget: null // OverviewWidget, owns the desktop thumbnails' drop targets
+
+    readonly property HyprlandMonitor monitor: Hyprland.monitorFor(panelWindow.screen)
+    readonly property int workspaceId: monitor?.activeWorkspace?.id ?? -1
+    readonly property real gap: 36
+    readonly property real labelHeight: 30
+    readonly property real maxScale: 0.8
+
+    readonly property var entries: {
+        const byAddress = HyprlandData.windowByAddress;
+        const out = [];
+        for (const toplevel of ToplevelManager.toplevels.values) {
+            const data = byAddress[`0x${toplevel.HyprlandToplevel.address}`];
+            // Pinned windows (e.g. the Wispr Flow pill) float over every desktop; Mission Control skips them.
+            if (!data || data.pinned || data.workspace?.id !== root.workspaceId || data.monitor !== root.monitor?.id)
+                continue;
+            out.push({ toplevel: toplevel, data: data });
+        }
+        // Keep a stable reading order: top-to-bottom, left-to-right as they sit on screen.
+        out.sort((a, b) => (a.data.at[1] - b.data.at[1]) || (a.data.at[0] - b.data.at[0]));
+        return out;
+    }
+
+    // The desktop as it is, scaled down: every window at its real position and size, so
+    // halves and quarters look like halves and quarters. One scale for the whole desktop.
+    readonly property var monitorData: HyprlandData.monitors.find(m => m.id === root.monitor?.id)
+    readonly property real areaX: (monitorData?.x ?? 0) + (monitorData?.reserved?.[0] ?? 0)
+    readonly property real areaY: (monitorData?.y ?? 0) + (monitorData?.reserved?.[1] ?? 0)
+    readonly property real areaW: Math.max(1, (monitor?.width ?? 1) / (monitor?.scale ?? 1) - (monitorData?.reserved?.[0] ?? 0) - (monitorData?.reserved?.[2] ?? 0))
+    readonly property real areaH: Math.max(1, (monitor?.height ?? 1) / (monitor?.scale ?? 1) - (monitorData?.reserved?.[1] ?? 0) - (monitorData?.reserved?.[3] ?? 0))
+    readonly property real spreadScale: Math.min(maxScale, width / areaW, height / areaH)
+
+    readonly property var layout: {
+        const out = [];
+        const left = (width - areaW * spreadScale) / 2;
+        const top = (height - areaH * spreadScale) / 2;
+        for (const e of entries) {
+            out.push({
+                x: Math.round(left + (e.data.at[0] - areaX) * spreadScale),
+                y: Math.round(top + (e.data.at[1] - areaY) * spreadScale),
+                w: Math.round(e.data.size[0] * spreadScale),
+                h: Math.round(e.data.size[1] * spreadScale)
+            });
+        }
+        return out;
+    }
+
+    // Report a drag to every monitor's overview (GlobalStates.crossDrag), and drop it on
+    // whichever desktop thumbnail is under the cursor, on either monitor.
+    function reportDrag(item, x, y) {
+        const p = item.mapToItem(null, x, y);
+        GlobalStates.crossDragPos = Qt.point((monitorData?.x ?? 0) + p.x, (monitorData?.y ?? 0) + p.y);
+    }
+    function endDrag(address) {
+        const widgets = (panelWindow.allPanels ?? []).map(p => p.widget).filter(w => w);
+        const target = widgets.find(w => w.draggingTargetWorkspace !== -1);
+        const ws = target?.draggingTargetWorkspace ?? -1;
+        const plan = target ? target.dropPlan(ws) : null;
+        GlobalStates.crossDrag = null;
+        for (const w of widgets)
+            w.clearWindowDrag();
+        if (ws !== -1 && ws !== root.workspaceId && plan)
+            target.dropWindow(address, plan);
+    }
+
+    Repeater {
+        model: root.entries.length
+
+        Item {
+            id: tile
+            required property int index
+            readonly property var entry: root.entries[index]
+            readonly property var geo: root.layout[index] ?? { x: 0, y: 0, w: 0, h: 0 }
+            readonly property string address: entry?.data?.address ?? ""
+            readonly property var desktopEntry: {
+                DesktopEntries.applications.values; // re-run when the entry index updates
+                return DesktopEntries.heuristicLookup(entry?.data?.class);
+            }
+            property bool dragging: false
+            // Where the window was grabbed, in tile coordinates. The window shrinks around this
+            // point so it stays under the cursor, and the drop target is picked from it too.
+            property real grabX: width / 2
+            property real grabY: height / 2
+            property real dragScale: dragging ? Math.min(1, 220 / Math.max(1, geo.w)) : 1
+
+            x: geo.x
+            y: geo.y
+            width: geo.w
+            height: geo.h
+            z: dragging ? 1000 : (entry?.data?.floating ? 1 : 0)
+            // Shrink while dragging so the window fits onto a desktop thumbnail, like macOS.
+            // Floating windows sit above tiled ones, as on the desktop.
+            transform: Scale {
+                origin.x: tile.grabX
+                origin.y: tile.grabY
+                xScale: tile.dragScale
+                yScale: tile.dragScale
+            }
+
+            Behavior on x { enabled: !tile.dragging; NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
+            Behavior on y { enabled: !tile.dragging; NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
+            Behavior on width { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
+            Behavior on height { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
+            Behavior on dragScale { NumberAnimation { duration: 160; easing.type: Easing.OutCubic } }
+
+
+            RectangularShadow {
+                anchors.fill: preview
+                radius: preview.radius
+                blur: 30
+                offset: Qt.vector2d(0, 8)
+                color: "#80000000"
+            }
+
+            ClippingRectangle {
+                id: preview
+                anchors.fill: parent
+                radius: 10
+                color: Appearance.colors.colLayer2
+                border.width: dragArea.containsMouse || tile.dragging ? 3 : 0
+                border.color: "#FFFFFF"
+
+                ScreencopyView {
+                    anchors.fill: parent
+                    captureSource: GlobalStates.overviewOpen ? tile.entry?.toplevel : null
+                    live: true
+                }
+            }
+
+            // App name pill, shown on hover like Mission Control.
+            Rectangle {
+                visible: dragArea.containsMouse && !tile.dragging
+                anchors.top: parent.bottom
+                anchors.topMargin: 8
+                anchors.horizontalCenter: parent.horizontalCenter
+                width: Math.min(label.implicitWidth + 24, Math.max(parent.width, 160))
+                height: label.implicitHeight + 10
+                radius: height / 2
+                color: "#CC1E1E1E"
+
+                Text {
+                    id: label
+                    anchors.centerIn: parent
+                    width: Math.min(implicitWidth, parent.width - 24)
+                    elide: Text.ElideRight
+                    text: tile.desktopEntry?.name || tile.entry?.data?.class || tile.entry?.data?.title || ""
+                    color: "#FFFFFF"
+                    font.pixelSize: Appearance.font.pixelSize.smaller
+                    font.family: Appearance.font.family.main
+                }
+            }
+
+            MouseArea {
+                id: dragArea
+                anchors.fill: parent
+                hoverEnabled: true
+                acceptedButtons: Qt.LeftButton | Qt.MiddleButton
+                drag.target: tile
+                drag.threshold: 8
+                cursorShape: tile.dragging ? Qt.ClosedHandCursor : Qt.PointingHandCursor
+
+                onPressed: mouse => {
+                    tile.grabX = mouse.x;
+                    tile.grabY = mouse.y;
+                }
+
+                drag.onActiveChanged: {
+                    if (drag.active) {
+                        tile.dragging = true;
+                        // Shrunk size for the other monitor's copy (see Overview.qml).
+                        const shrink = Math.min(1, 220 / Math.max(1, tile.geo.w));
+                        GlobalStates.crossDrag = {
+                            kind: "window", address: tile.address, toplevel: tile.entry?.toplevel,
+                            workspace: root.workspaceId, monitor: root.monitor?.id,
+                            w: tile.geo.w * shrink, h: tile.geo.h * shrink,
+                            grabX: tile.grabX * shrink, grabY: tile.grabY * shrink
+                        };
+                    }
+                }
+
+                onPositionChanged: mouse => {
+                    if (tile.dragging)
+                        root.reportDrag(dragArea, mouse.x, mouse.y);
+                }
+
+                onReleased: {
+                    if (!tile.dragging)
+                        return;
+                    tile.dragging = false;
+                    root.endDrag(tile.address);
+                    // Snap back into place (or out of the way once the window has moved).
+                    tile.x = Qt.binding(() => tile.geo.x);
+                    tile.y = Qt.binding(() => tile.geo.y);
+                }
+
+                onCanceled: {
+                    if (!tile.dragging)
+                        return;
+                    tile.dragging = false;
+                    GlobalStates.crossDrag = null;
+                    tile.x = Qt.binding(() => tile.geo.x);
+                    tile.y = Qt.binding(() => tile.geo.y);
+                }
+
+                onClicked: event => {
+                    if (tile.dragging || !tile.address)
+                        return;
+                    if (event.button === Qt.LeftButton) {
+                        GlobalStates.overviewOpen = false;
+                        if (Hyprland.usingLua)
+                            Hyprland.dispatch(`hl.dsp.focus({ window = 'address:${tile.address}' })`);
+                        else
+                            Hyprland.dispatch(`focuswindow address:${tile.address}`);
+                    } else if (event.button === Qt.MiddleButton) {
+                        if (Hyprland.usingLua)
+                            Hyprland.dispatch(`hl.dsp.window.close('address:${tile.address}')`);
+                        else
+                            Hyprland.dispatch(`closewindow address:${tile.address}`);
+                    }
+                }
+            }
+        }
+    }
+}
