#!/usr/bin/env python3
"""Mute other apps' audio while Wispr Flow is dictating.

The Linux build of Wispr Flow has the "Mute music while dictating" setting but
never acts on it: on macOS the Swift helper does the muting, and the Linux
helper (wispr-flow-linux) has no audio code. This fills that gap.

Wispr opens the microphone only while dictating, so its PipeWire capture
stream is the signal: while it exists, every playback stream not owned by
Wispr is muted, including ones that start mid-dictation. When it closes, only
the streams muted here are unmuted (anything you had muted stays muted).

A stream that closes while muted here can't be unmuted, and WirePlumber has
saved that mute against the app's name, so the app's next stream starts muted.
Those apps are remembered as "stale", and their next muted stream is put right.

Controlled by Wispr's own setting: prefs.user.shouldMuteAudio in
~/.config/Wispr Flow/config.json, read each time dictation starts.

Runs as the wispr-mute systemd user service.
"""

import json
import os
import signal
import subprocess
import sys
import time

CONFIG = os.environ.get("WISPR_MUTE_CONFIG") or os.path.expanduser(
    "~/.config/Wispr Flow/config.json"
)
STATE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "wispr-mute.json"
)
DEBUG = bool(os.environ.get("WISPR_MUTE_DEBUG"))


def log(msg):
    print(msg, flush=True)


def pactl_json(kind):
    out = subprocess.run(
        ["pactl", "-f", "json", "list", kind],
        capture_output=True, text=True, check=True,
    ).stdout
    return json.loads(out or "[]")


def is_wispr(stream):
    p = stream.get("properties", {})
    binary = (p.get("application.process.binary") or "").lower()
    name = (p.get("application.name") or "").lower()
    return binary.startswith("wispr-flow") or "wispr" in name


def app_name(stream):
    return stream.get("properties", {}).get("application.name") or ""


def describe(stream):
    p = stream.get("properties", {})
    return "{} ({})".format(
        stream["index"],
        p.get("application.name") or p.get("node.name") or "?",
    )


def mute_enabled():
    """Wispr's "mute music while dictating" setting; last good value on a bad read."""
    try:
        with open(CONFIG) as f:
            user = json.load(f).get("prefs", {}).get("user", {})
        mute_enabled.last = bool(user.get("shouldMuteAudio"))
    except (OSError, ValueError) as e:
        log(f"could not read {CONFIG}: {e}; using {mute_enabled.last}")
    return mute_enabled.last


mute_enabled.last = False


def set_mute(index, muted):
    # The stream can vanish between listing and muting; that's fine.
    subprocess.run(
        ["pactl", "set-sink-input-mute", str(index), "1" if muted else "0"],
        capture_output=True,
    )


def save_state(muted, stale):
    try:
        with open(STATE, "w") as f:
            json.dump({
                "muted": {str(i): app for i, app in muted.items()},
                "stale": sorted(stale),
            }, f)
    except OSError:
        pass


def load_state():
    """Returns (muted, stale): {sink-input index: app name} and a set of app names."""
    try:
        with open(STATE) as f:
            data = json.load(f)
        return (
            {int(i): app for i, app in data["muted"].items()},
            set(data["stale"]),
        )
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return {}, set()


class Muter:
    def __init__(self):
        self.active = False  # dictation in progress and muting enabled
        self.muted = {}      # sink-input index -> app name, muted by us
        self.stale = set()   # apps whose saved mute we left behind

        # A previous run that died mid-dictation leaves streams muted.
        self.muted, self.stale = load_state()
        if self.muted:
            log(f"restoring streams left muted by a previous run: {sorted(self.muted)}")
            self.restore()

    def forget_closed(self, streams):
        """Streams we muted that have closed leave a saved mute behind for their app."""
        live = {s["index"] for s in streams}
        for index in set(self.muted) - live:
            app = self.muted.pop(index)
            if app:
                self.stale.add(app)
                log(f"{index} ({app}) closed while muted; will clear its saved mute")

    def clear_stale(self, streams):
        """Put right a stale app's next muted stream, restored by WirePlumber."""
        for s in streams:
            app = app_name(s)
            if app not in self.stale or not s.get("mute"):
                continue
            self.stale.discard(app)
            if s["index"] in self.muted:
                continue  # already ours; unmuting it after dictation clears the save
            if self.active:
                self.muted[s["index"]] = app
            else:
                set_mute(s["index"], False)
                log(f"cleared saved mute on {describe(s)}")

    def restore(self):
        streams = pactl_json("sink-inputs")
        self.forget_closed(streams)
        for index in self.muted:
            set_mute(index, False)
        if self.muted:
            log(f"unmuted {sorted(self.muted)}")
        self.muted.clear()
        # Streams just unmuted report their old state until re-listed, so use a fresh list.
        self.clear_stale(pactl_json("sink-inputs"))
        save_state(self.muted, self.stale)

    def update(self):
        recording = [s for s in pactl_json("source-outputs") if is_wispr(s)]
        if DEBUG:
            log(f"wispr capture streams: {[describe(s) for s in recording]}")

        if recording and not self.active:
            if mute_enabled():
                self.active = True
                log("dictation started: muting other apps")
        elif not recording and self.active:
            self.active = False
            log("dictation ended")
            self.restore()
            return

        streams = pactl_json("sink-inputs")
        self.forget_closed(streams)
        self.clear_stale(streams)

        if self.active:
            # Mute anything playing that isn't Wispr and isn't already muted,
            # including streams that started during dictation.
            for s in streams:
                if is_wispr(s) or s["index"] in self.muted or s.get("mute"):
                    continue
                set_mute(s["index"], True)
                self.muted[s["index"]] = app_name(s)
                log(f"muted {describe(s)}")
        save_state(self.muted, self.stale)

    def reconnect(self):
        """PipeWire restarted: every stream is gone, but the saved mutes aren't."""
        self.active = False
        self.stale.update(app for app in self.muted.values() if app)
        self.muted.clear()
        save_state(self.muted, self.stale)


MUTER = None


def main():
    global MUTER
    muter = MUTER = Muter()
    muter.update()
    while True:
        proc = subprocess.Popen(
            ["pactl", "subscribe"], stdout=subprocess.PIPE, text=True
        )
        for line in proc.stdout:
            # e.g. "Event 'new' on source-output #123"
            if "source-output" in line or (
                (muter.active or muter.stale) and "sink-input" in line
            ):
                try:
                    muter.update()
                except (subprocess.CalledProcessError, ValueError) as e:
                    log(f"update failed: {e}")
        # pactl exits when PipeWire restarts. Reconnect.
        proc.wait()
        log("pactl subscribe exited; reconnecting")
        muter.reconnect()
        time.sleep(2)


if __name__ == "__main__":
    # On stop (SIGTERM from systemd), unmute what we muted before exiting.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        main()
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        if MUTER is not None and MUTER.muted:
            MUTER.restore()
