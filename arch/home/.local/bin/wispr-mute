#!/usr/bin/env python3
"""Mute other apps' audio while Wispr Flow is dictating.

The Linux build of Wispr Flow has the "Mute music while dictating" setting but
never acts on it: on macOS the Swift helper does the muting, and the Linux
helper (wispr-flow-linux) has no audio code. This fills that gap.

Wispr opens the microphone only while dictating, so its PipeWire capture
stream is the signal: while it exists, every playback stream not owned by
Wispr is muted, including ones that start mid-dictation. When it closes, only
the streams muted here are unmuted (anything you had muted stays muted).

Controlled by Wispr's own setting: prefs.user.shouldMuteAudio in
~/.config/Wispr Flow/config.json, read each time dictation starts.

Runs as the wispr-mute systemd user service.
"""

import json
import os
import signal
import subprocess
import sys
import time

CONFIG = os.environ.get("WISPR_MUTE_CONFIG") or os.path.expanduser(
    "~/.config/Wispr Flow/config.json"
)
STATE = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "wispr-mute.json"
)
DEBUG = bool(os.environ.get("WISPR_MUTE_DEBUG"))


def log(msg):
    print(msg, flush=True)


def pactl_json(kind):
    out = subprocess.run(
        ["pactl", "-f", "json", "list", kind],
        capture_output=True, text=True, check=True,
    ).stdout
    return json.loads(out or "[]")


def is_wispr(stream):
    p = stream.get("properties", {})
    binary = (p.get("application.process.binary") or "").lower()
    name = (p.get("application.name") or "").lower()
    return binary.startswith("wispr-flow") or "wispr" in name


def describe(stream):
    p = stream.get("properties", {})
    return "{} ({})".format(
        stream["index"],
        p.get("application.name") or p.get("node.name") or "?",
    )


def mute_enabled():
    """Wispr's "mute music while dictating" setting; last good value on a bad read."""
    try:
        with open(CONFIG) as f:
            user = json.load(f).get("prefs", {}).get("user", {})
        mute_enabled.last = bool(user.get("shouldMuteAudio"))
    except (OSError, ValueError) as e:
        log(f"could not read {CONFIG}: {e}; using {mute_enabled.last}")
    return mute_enabled.last


mute_enabled.last = False


def set_mute(index, muted):
    # The stream can vanish between listing and muting; that's fine.
    subprocess.run(
        ["pactl", "set-sink-input-mute", str(index), "1" if muted else "0"],
        capture_output=True,
    )


def save_state(muted):
    try:
        with open(STATE, "w") as f:
            json.dump(sorted(muted), f)
    except OSError:
        pass


def load_state():
    try:
        with open(STATE) as f:
            return set(json.load(f))
    except (OSError, ValueError):
        return set()


class Muter:
    def __init__(self):
        self.active = False  # dictation in progress and muting enabled
        self.muted = set()   # sink-input indexes muted by us

        # A previous run that died mid-dictation leaves streams muted.
        leftover = load_state()
        if leftover:
            log(f"restoring streams left muted by a previous run: {sorted(leftover)}")
            self.muted = leftover
            self.restore()

    def restore(self):
        live = {s["index"] for s in pactl_json("sink-inputs")}
        for index in self.muted & live:
            set_mute(index, False)
        if self.muted:
            log(f"unmuted {sorted(self.muted & live)}")
        self.muted.clear()
        save_state(self.muted)

    def update(self):
        recording = [s for s in pactl_json("source-outputs") if is_wispr(s)]
        if DEBUG:
            log(f"wispr capture streams: {[describe(s) for s in recording]}")

        if recording and not self.active:
            if not mute_enabled():
                return  # setting off: leave audio alone for this dictation
            self.active = True
            log("dictation started: muting other apps")
        elif not recording and self.active:
            self.active = False
            log("dictation ended")
            self.restore()
            return

        if not self.active:
            return

        # Mute anything playing that isn't Wispr and isn't already muted,
        # including streams that started during dictation.
        for s in pactl_json("sink-inputs"):
            if is_wispr(s) or s["index"] in self.muted or s.get("mute"):
                continue
            set_mute(s["index"], True)
            self.muted.add(s["index"])
            log(f"muted {describe(s)}")
        save_state(self.muted)


MUTER = None


def main():
    global MUTER
    muter = MUTER = Muter()
    muter.update()
    while True:
        proc = subprocess.Popen(
            ["pactl", "subscribe"], stdout=subprocess.PIPE, text=True
        )
        for line in proc.stdout:
            # e.g. "Event 'new' on source-output #123"
            if "source-output" in line or (muter.active and "sink-input" in line):
                try:
                    muter.update()
                except (subprocess.CalledProcessError, ValueError) as e:
                    log(f"update failed: {e}")
        # pactl exits when PipeWire restarts; streams are gone, so unmute
        # bookkeeping is moot. Reconnect.
        proc.wait()
        log("pactl subscribe exited; reconnecting")
        muter.active = False
        muter.muted.clear()
        save_state(muter.muted)
        time.sleep(2)


if __name__ == "__main__":
    # On stop (SIGTERM from systemd), unmute what we muted before exiting.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        main()
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        if MUTER is not None and MUTER.muted:
            MUTER.restore()
