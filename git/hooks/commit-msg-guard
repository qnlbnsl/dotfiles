#!/usr/bin/env sh
# Block Co-Authored-By trailers in commit messages, on every repo and machine.
# Runs for `git commit`, `gcs` (git commit --gpg-sign), merges and amends,
# whichever agent or person commits. Bypass only with --no-verify.
#
# Only the trailer is blocked. Model, vendor and harness names (a commit about
# the Codex adapter, a copied file whose name contains "claude") are ordinary
# words and are allowed, as in T3 Code's history.

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# Drop git's comment lines before matching.
hits=$(grep -v '^#' "$msg_file" | grep -n -i -E '^[[:space:]]*co-authored-by[[:space:]]*:' || true)

if [ -n "$hits" ]; then
  echo "commit-msg: Co-Authored-By trailers are not allowed in commit messages." >&2
  echo "Remove these lines, then commit again:" >&2
  printf '%s\n' "$hits" | sed 's/^/  line /' >&2
  exit 1
fi
exit 0
